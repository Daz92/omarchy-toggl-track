#!/usr/bin/env bash
# Release gate. Nothing compiles — QML and Python ship as source. This refuses
# to tag a version that would not work once cloned.
set -eu

check_only=0
case "${1:-}" in
    --check) check_only=1 ;;
    "") ;;
    *) printf 'usage: build [--check]\n' >&2; exit 2 ;;
esac

root=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
cd "$root"
step=0
say() { step=$((step + 1)); printf '[%2d] %s\n' "$step" "$1" >&2; }
die() { printf 'FAIL: %s\n' "$1" >&2; exit 1; }

say 'manifest schema'
omarchy plugin validate . >/dev/null || die 'omarchy plugin validate rejected the manifest'

say 'python syntax'
python3 -m py_compile toggl_api.py toggl_log.py toggl_perf.py toggl_secret.py toggl_doctor.py \
    toggl_demo.py tests/*.py || die 'py_compile failed'

say 'python tests'
python3 -m unittest discover -s tests >/dev/null || die 'python tests failed'

say 'node tests'
node tests/test_model.mjs >/dev/null || die 'node tests failed'

say 'shell syntax'
for file in setup build install; do
    [ -e "$file" ] || continue
    bash -n "$file" || die "bash -n failed on $file"
done

say 'qml formatting'
# Never pipe qmlformat or qmllint and read $? — they write nothing on failure,
# so `qmllint x.qml | tail` returns tail's status and a broken file reads green.
for file in Panel.qml ui/*.qml; do
    [ -e "$file" ] || continue
    if ! qmlformat "$file" >/dev/null 2>&1; then
        die "qmlformat rejected $file"
    fi
done

say 'text rulings (T-A, T-B, T-C, T-E)'
# T-A. Qt's default textFormat is AutoText, which renders a string as HTML when
# it looks like HTML. Toggl descriptions, project names and window titles all
# reach Text items, so a description of `<b>ship it</b>` renders bold and the
# text the user typed is gone. Every Text declares its format.
unset_format=$(python3 - <<'PY'
import glob, re
bad = []
for name in ["Panel.qml"] + sorted(glob.glob("ui/*.qml")):
    source = open(name).read()
    for match in re.finditer(r"(?ms)^(\s*)(?:\w+:\s*)?Text \{\n(.*?)^\1\}", source):
        if "textFormat:" not in match.group(2):
            bad.append("%s:%d" % (name, source[:match.start()].count("\n") + 1))
print(" ".join(bad))
PY
)
[ -z "$unset_format" ] || die "Text without textFormat (ruling T-A): $unset_format"

# T-B. An eliding Text that may fill must also be allowed to shrink, or the
# layout hands it its implicit width and the ellipsis never appears.
unpaired_elide=$(python3 - <<'PY'
import glob, re
bad = []
for name in ["Panel.qml"] + sorted(glob.glob("ui/*.qml")):
    source = open(name).read()
    for match in re.finditer(r"(?ms)^(\s*)(?:\w+:\s*)?Text \{\n(.*?)^\1\}", source):
        body = match.group(2)
        if "elide: Text.Elide" in body and "ElideNone" not in body \
                and "Layout.fillWidth: true" in body and "Layout.minimumWidth" not in body:
            bad.append("%s:%d" % (name, source[:match.start()].count("\n") + 1))
print(" ".join(bad))
PY
)
[ -z "$unpaired_elide" ] || die "eliding Text without Layout.minimumWidth (ruling T-B): $unpaired_elide"

# T-C. Two values only: 0 for sentence case, 1 for uppercase micro-labels.
if grep -hoE 'font\.letterSpacing: [0-9.]+' Panel.qml ui/*.qml | grep -qvE 'font\.letterSpacing: [01]$'; then
    die 'letterSpacing outside the 0/1 scale (ruling T-C)'
fi

# T-E. Uppercase is the metadata register; a control is sentence case.
if grep -hE '^\s*text: "[A-Z][A-Z0-9 ]+"' Panel.qml ui/*.qml | grep -q .; then
    if grep -rlE '^\s*text: "(APPLY|RETRY|TODAY|RESET|SAVE|CANCEL)"' Panel.qml ui/*.qml | grep -q .; then
        die 'control label in caps (ruling T-E)'
    fi
fi

# T-J. panelTheme is the only colour path outside the role object itself.
if grep -nE '(^|[^.\w])Color\.' Panel.qml ui/DayScope.qml ui/TimerScope.qml ui/CalendarScope.qml ui/DayHeader.qml ui/HelpOverlay.qml | grep -vE '^\S+: *//| // '; then
    die 'Color.* reached directly; use panelTheme.* (ruling T-J)'
fi

say 'BarWidget.qml needs hand review'
printf '     both QML tools reject `function open(): void`, which IpcHandler requires\n' >&2

say 'nothing unshippable is tracked'
for pattern in 'logs/' '\.gguf$' '__pycache__/' 'dist/'; do
    if git ls-files | grep -qE "$pattern"; then
        die "tracked files match $pattern"
    fi
done
# A Toggl API token is exactly 32 hex characters. Match that length exactly:
# the 64-hex sha256 that pins the classifier model in `setup` is not a token,
# and a looser {32} would flag it.
if git grep -nIE '(^|[^0-9a-f])[0-9a-f]{32}([^0-9a-f]|$)' -- . ':!docs' ':!tests' >/dev/null 2>&1; then
    die 'a 32-hex string is tracked outside docs and tests; check for a leaked token'
fi

say 'no unfilled placeholders in what users read'
# `omarchy plugin add` clones the repo and the README is the first thing anyone
# reads, so a placeholder URL there ships as an instruction that cannot work.
# Only a repository with a remote can be installed that way, so the placeholder
# is a defect from the moment one exists -- and not before.
if remote=$(git remote get-url origin 2>/dev/null) && [ -n "$remote" ]; then
    if grep -q '<owner>' README.md HOW-TO.md; then
        die "README.md or HOW-TO.md still says <owner>; the remote is $remote"
    fi
elif grep -q '<owner>' README.md HOW-TO.md; then
    printf '     README.md still says <owner>; fill it in before publishing\n' >&2
fi

say 'working tree and version'
[ -z "$(git status --porcelain)" ] || die 'working tree is dirty'
version=$(python3 -c 'import json;print(json.load(open("manifest.json"))["version"])')
if git rev-parse -q --verify "refs/tags/v$version" >/dev/null; then
    die "v$version is already tagged; bump manifest.json"
fi

if [ "$check_only" -eq 1 ]; then
    printf 'OK: v%s passes every check\n' "$version" >&2
    exit 0
fi

say 'artifact'
rm -rf dist
mkdir -p dist
name="omarchy-toggl-track-$version"
git archive --format=tar.gz --prefix="$name/" -o "dist/$name.tar.gz" HEAD
( cd dist && sha256sum "$name.tar.gz" > SHA256SUMS )
printf 'OK: dist/%s.tar.gz\n' "$name" >&2
